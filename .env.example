# QQ Agent Mail MCP 运行时配置示例
#
# 用法：复制为 .env（已被 gitignore），按需修改。
# 加载规则：真实环境变量优先；.env 仅提供默认值，不覆盖已存在的环境变量。
# 默认读取工作目录下的 .env；用 QQ_AGENT_MAIL_MCP_ENV_FILE 指定其它路径
# （例如容器内 /etc/qq-agent-mail-mcp/config.env）。
#
# 注意：版本号不在这里配置，它由构建时 ldflags 注入（见 Makefile）。

# StreamableHTTP 监听地址
QQ_AGENT_MAIL_MCP_BIND=127.0.0.1:8765

# agently-cli 可执行文件路径（PATH 能找到时写名字即可）
QQ_AGENTLY_CLI_BIN=agently-cli

# 预留：MCP bearer token 尚未实现。实现后推荐用文件挂载，不要在此写明文 token。
# QQ_AGENT_MAIL_MCP_AUTH_TOKEN_FILE=/run/secrets/qq-agent-mail-mcp-token

# 指定 .env 文件路径（默认 ./.env）
# QQ_AGENT_MAIL_MCP_ENV_FILE=/etc/qq-agent-mail-mcp/config.env
